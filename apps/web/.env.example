# Settings the web app needs (set them in Vercel → Project → Settings → Environment Variables).
# Names only; never commit real values. Supabase is only the Postgres host: no Supabase keys are used.

# Database: the transaction pooler connection string (port 6543).
DATABASE_URL=
# Production only (not Preview): the session pooler string (port 5432). Production deploys apply migrations with it.
PROD_DIRECT_DATABASE_URL=

# Sign-up gate: open (the default since 2026-11-06): anyone with a verified email may create a family.
# SIGNUP_MODE=invite limits it to the emails (comma-separated) in ALLOWED_SIGNUP_EMAILS.
SIGNUP_MODE=open
ALLOWED_SIGNUP_EMAILS=

# "Continue with Google": the OAuth client from Google Cloud → Google Auth Platform → Clients (Web application).
# Its redirect URI is <APP_URL>/api/v1/auth/google/callback. Without both, the Google button says it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails that may load the family's own plan at setup ("Import our plan").
PLAN_IMPORT_EMAILS=

# The app's address, e.g. https://<project>.vercel.app: links in reminder, verify and reset emails, and the Google
# redirect. Required in production (sign-up and "forgot password" refuse to build links without it).
APP_URL=
# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Email: verify-email and reset-password links, and the fallback for bill and shortfall reminders (Gmail SMTP, app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# AI — voice (Stage 2) and receipts (Stage 3). Names only; never commit a value.
# Understanding: OPENAI_API_KEY, with AI_MODEL defaulting to gpt-6.1-terra (TRD 10.2).
OPENAI_API_KEY=
AI_MODEL=
AI_EFFORT=
# Speech to text: STT_PROVIDER is openai or sarvam, chosen by the Stage 2 test (TRD 9).
STT_PROVIDER=openai
STT_API_KEY=
# Sarvam's own key, used by the comparison script alongside OPENAI_API_KEY.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
# Monthly voice allowance per family, and families exempt from it (comma-separated ids).
CAP_VOICE_PER_MONTH=400
UNCAPPED_FAMILY_IDS=
