# Copy this file to .env.local (gitignored) and fill in the values. Never commit real values.

# Supabase (dev project first; prod values go in Vercel's env settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database: the app builds the connection URL from these five (the password is URL-encoded for you).
# A full DATABASE_URL, if set, wins over them.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=

# Google sign-in (OAuth client; the secret is also entered in Supabase Auth > Providers > Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Gmail SMTP (app password; also entered in Supabase Auth > SMTP settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# App
APP_URL=
CRON_SECRET=
SIGNUP_MODE=invite
ALLOWED_SIGNUP_EMAILS=
PLAN_IMPORT_EMAILS=

# AI (Stage 2-3; not needed yet)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
STT_PROVIDER=
STT_API_KEY=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=