# Copy to .env.local (gitignored) for local work and scripts. Names only here; never commit real values.
# The web app on Vercel uses the list in apps/web/.env.example.

# Local database (development, integration tests, seed:dev). The URL is built from these five parts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Integration tests use DB_* with database TEST_DB_NAME (default nestwise_test), or TEST_DATABASE_URL.
TEST_DB_NAME=
TEST_DATABASE_URL=

# Hosted database (Supabase is only the Postgres host). DATABASE_URL wins over DB_* when set.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Production direct connection (port 5432), only for `pnpm --filter @nestwise/db migrate:prod` and the plan import.
PROD_DIRECT_DATABASE_URL=

# Email via Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# App
APP_URL=
CRON_SECRET=
SIGNUP_MODE=invite
ALLOWED_SIGNUP_EMAILS=
PLAN_IMPORT_EMAILS=

# AI — voice (Stage 2) and receipts (Stage 3). Names only; never commit a value.
# Understanding: OPENAI_API_KEY, with AI_MODEL defaulting to gpt-6.1-terra (TRD 10.2).
OPENAI_API_KEY=
AI_MODEL=
AI_EFFORT=
# Speech to text: STT_PROVIDER is openai or sarvam, chosen by the Stage 2 test (TRD 9).
STT_PROVIDER=openai
STT_API_KEY=
# Sarvam's own key, used by the comparison script alongside OPENAI_API_KEY.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
# Monthly voice allowance per family, and families exempt from it (comma-separated ids).
CAP_VOICE_PER_MONTH=400
UNCAPPED_FAMILY_IDS=

# Page slide transitions: leave unset (off) until checked on a real iPhone, then set to on.
NEXT_PUBLIC_PAGE_SLIDES=
