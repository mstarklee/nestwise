# Copy to .env.local (gitignored) for local work and scripts. Names only here; never commit real values.
# The web app on Vercel uses the list in apps/web/.env.example.

# Local database (development, integration tests, seed:dev). The URL is built from these five parts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Integration tests use DB_* with database TEST_DB_NAME (default nestwise_test), or TEST_DATABASE_URL.
TEST_DB_NAME=
TEST_DATABASE_URL=

# Hosted database (Supabase is only the Postgres host). DATABASE_URL wins over DB_* when set.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Production direct connection (port 5432), only for `pnpm --filter @nestwise/db migrate:prod` and the plan import.
PROD_DIRECT_DATABASE_URL=

# Email via Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# App
APP_URL=
CRON_SECRET=
SIGNUP_MODE=invite
ALLOWED_SIGNUP_EMAILS=
PLAN_IMPORT_EMAILS=

# AI (Stages 2-3; not needed yet)
OPENAI_API_KEY=
