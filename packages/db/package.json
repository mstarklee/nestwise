{
  "name": "@nestwise/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env.local --import tsx src/migrate.ts",
    "migrate:prod": "node --env-file-if-exists=../../.env.local --import tsx src/migrate.ts --prod",
    "migrate:deploy": "tsx src/migrate.ts --deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
